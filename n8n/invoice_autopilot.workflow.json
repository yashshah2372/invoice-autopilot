            "version": 2
          },
          "conditions": [
            {
              "id": "7bd402de-a428-489a-b26a-bc856f79f91b",
              "leftValue": "={{ $json.skipped }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
