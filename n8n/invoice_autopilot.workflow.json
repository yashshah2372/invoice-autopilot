              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "has:attachment (invoice OR receipt OR bill) -label:ap-processed"
        },
        "options": {
          "downloadAttachments": true
        }
      },
      "id": "4941161d-9aa9-43ab-8e9a-202852a75edc",
      "name": "Gmail: new invoice email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-autopilot",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "03f2a2bd-5b10-4b4a-bf76-b1a327651ccf",
      "name": "Webhook: upload invoice",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "webhookId": "38d8fbdb-26a1-4603-91b4-b7b0efe56a8a"
    },
    {
      "parameters": {
        "jsCode": "// One item per PDF/image attachment, normalised to binary field \"data\"\nconst out = [];\nfor (const item of $input.all()) {\n  for (const [key, bin] of Object.entries(item.binary || {})) {\n    const mime = bin.mimeType || '';\n    if (!/pdf|image/i.test(mime)) continue;\n    // skip email-signature logos and tracking pixels: images under ~40 kB\n    const m = String(bin.fileSize || '').match(/([\\d.]+)\\s*(kB|MB|B)/i);\n    const bytes = m ? parseFloat(m[1]) * ({ b: 1, kb: 1e3, mb: 1e6 })[m[2].toLowerCase()] : Infinity;\n    if (/image/i.test(mime) && bytes < 40000) continue;\n    out.push({\n      json: {\n        fileName: bin.fileName,\n        emailSubject: item.json.subject || null,\n        emailFrom: (item.json.from && item.json.from.text) || null,\n        source: item.json.subject ? 'gmail' : 'webhook',\n      },\n      binary: { data: bin },\n    });\n  }\n}\nreturn out;"
      },
      "id": "5d06fa01-07c0-41e3-a93a-2dd6774cc1f4",
      "name": "Split attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTOPILOT_API_URL || 'http://api:8000' }}/extract",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "source",
              "value": "={{ $json.source }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AUTOPILOT_API_KEY || '' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "cb990b11-3dac-4ed4-a406-c9fb8b0cda8c",
      "name": "Extract + check (AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
